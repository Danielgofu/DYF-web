# DYF Telecomunicaciones — configuración para hosting compartido Apache (Nominalia)
# Este archivo se copia tal cual a /dist en cada build de Vite (public/ -> dist/).
# Las rutas de las secciones 3 y 4 las comprueba scripts/generar-cabeceras.mjs en cada
# `npm run build`: si no coinciden con App.tsx, src/seo/rutas.json y sitemap.xml, el build falla.

# Sin listado de directorios. Sin MultiViews: si no, Apache podría servir servicios.html para
# /servicios por negociación de contenido, al margen de estas reglas.
Options -Indexes -MultiViews

# Cualquier URL que no sea una ruta conocida ni un archivo existente: 404 real con la página
# 404 generada (noindex, sin canonical). Ruta local: Apache conserva el código 404.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 0. Redirecciones 301 de la web antigua (HTML estático, indexada por Google con y sin "www"
  #    y solo por http). Van ANTES de las reglas de HTTPS y www para que cada URL antigua
  #    llegue a su destino final en UN solo salto (http://dyfservicios.com/servicios.html ->
  #    https://www.dyfservicios.com/servicios). En .htaccess el patrón se compara con la ruta
  #    SIN la barra inicial ("servicios.html"). [NC] = sin distinguir mayúsculas; la query
  #    string (?fbclid=...) se conserva sola.
  #
  #    TODAS llevan la condición THE_REQUEST: es la línea original que envió el navegador
  #    ("GET /servicios.html HTTP/1.1") y no cambia con las reescrituras internas. Hace falta
  #    porque la sección 4 reescribe /servicios -> servicios.html (y mod_dir, / -> index.html),
  #    y Apache vuelve a evaluar este archivo con esa ruta interna: sin la condición, la regla
  #    de servicios.html la atraparía y redirigiría /servicios a sí misma en bucle.
  RewriteCond %{THE_REQUEST} \s/index\.html?[\s?] [NC]
  RewriteRule ^index\.html?$ https://www.dyfservicios.com/ [R=301,L,NC]
  RewriteCond %{THE_REQUEST} \s/nosotros\.html?[\s?] [NC]
  RewriteRule ^nosotros\.html?$ https://www.dyfservicios.com/equipo [R=301,L,NC]
  RewriteCond %{THE_REQUEST} \s/servicios\.html?[\s?] [NC]
  RewriteRule ^servicios\.html?$ https://www.dyfservicios.com/servicios [R=301,L,NC]
  RewriteCond %{THE_REQUEST} \s/comunidades\.html?[\s?] [NC]
  RewriteRule ^comunidades\.html?$ https://www.dyfservicios.com/mantenimiento [R=301,L,NC]
  RewriteCond %{THE_REQUEST} \s/contacto\.html?[\s?] [NC]
  RewriteRule ^contacto\.html?$ https://www.dyfservicios.com/contacto [R=301,L,NC]

  # 0b. Los .html que genera el build, pedidos directamente por el navegador (/equipo.html...),
  #     redirigen a su URL limpia para no tener dos URLs con el mismo contenido. Llevan la misma
  #     condición THE_REQUEST: la sección 4 reescribe /equipo -> equipo.html por dentro y, sin
  #     ella, esta regla redirigiría /equipo a sí misma en bucle. (servicios.html y
  #     contacto.html ya los cubren las reglas de la web antigua de arriba.)
  RewriteCond %{THE_REQUEST} \s/equipo\.html?[\s?] [NC]
  RewriteRule ^equipo\.html?$ https://www.dyfservicios.com/equipo [R=301,L,NC]
  RewriteCond %{THE_REQUEST} \s/mantenimiento\.html?[\s?] [NC]
  RewriteRule ^mantenimiento\.html?$ https://www.dyfservicios.com/mantenimiento [R=301,L,NC]
  RewriteCond %{THE_REQUEST} \s/gracias\.html?[\s?] [NC]
  RewriteRule ^gracias\.html?$ https://www.dyfservicios.com/gracias [R=301,L,NC]
  RewriteCond %{THE_REQUEST} \s/aviso-legal\.html?[\s?] [NC]
  RewriteRule ^aviso-legal\.html?$ https://www.dyfservicios.com/aviso-legal [R=301,L,NC]
  RewriteCond %{THE_REQUEST} \s/politica-privacidad\.html?[\s?] [NC]
  RewriteRule ^politica-privacidad\.html?$ https://www.dyfservicios.com/politica-privacidad [R=301,L,NC]

  # 1. Forzar HTTPS, directamente al dominio con www (un solo salto desde http://sin-www)
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://www.dyfservicios.com%{REQUEST_URI} [L,R=301]

  # 2. Forzar "www" cuando ya se llega por https sin www
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2b. /404.html pedido directamente: 404 real (no 200). R=404 hace que Apache sirva el
  #     ErrorDocument, que es este mismo archivo mediante una redirección interna en la que
  #     THE_REQUEST sigue siendo "/404.html"; REDIRECT_STATUS vacío (solo lo está en la
  #     petición original del navegador) evita que la regla vuelva a dispararse ahí.
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{THE_REQUEST} \s/404\.html?[\s?] [NC]
  RewriteRule ^404\.html?$ - [R=404,L,NC]

  # 3. Rutas conocidas con barra final -> 301 a la URL canónica (sin barra y en minúsculas).
  RewriteRule ^equipo/$ https://www.dyfservicios.com/equipo [R=301,L,NC]
  RewriteRule ^servicios/$ https://www.dyfservicios.com/servicios [R=301,L,NC]
  RewriteRule ^contacto/$ https://www.dyfservicios.com/contacto [R=301,L,NC]
  RewriteRule ^mantenimiento/$ https://www.dyfservicios.com/mantenimiento [R=301,L,NC]
  RewriteRule ^gracias/$ https://www.dyfservicios.com/gracias [R=301,L,NC]
  RewriteRule ^aviso-legal/$ https://www.dyfservicios.com/aviso-legal [R=301,L,NC]
  RewriteRule ^politica-privacidad/$ https://www.dyfservicios.com/politica-privacidad [R=301,L,NC]

  # 4. Rutas conocidas -> su HTML con la cabecera propia (generado en el build). El destino es
  #    siempre en minúsculas, así /SERVICIOS también sirve servicios.html (el canonical ya es
  #    /servicios). La portada "/" la sirve mod_dir con index.html. Todo lo demás que no sea un
  #    archivo existente cae en el ErrorDocument 404 de arriba: ya no hay fallback genérico.
  RewriteRule ^equipo$ equipo.html [L,NC]
  RewriteRule ^servicios$ servicios.html [L,NC]
  RewriteRule ^contacto$ contacto.html [L,NC]
  RewriteRule ^mantenimiento$ mantenimiento.html [L,NC]
  RewriteRule ^gracias$ gracias.html [L,NC]
  RewriteRule ^aviso-legal$ aviso-legal.html [L,NC]
  RewriteRule ^politica-privacidad$ politica-privacidad.html [L,NC]
</IfModule>

# Compresión de los archivos de texto. Si el servidor tiene mod_brotli, los navegadores que
# lo aceptan reciben brotli; el resto, gzip (mod_deflate). Ninguno de los dos vuelve a comprimir
# una respuesta que ya lleva Content-Encoding, así que pueden convivir. AddOutputFilterByType es
# de mod_filter en Apache 2.4: sin ese <IfModule>, si faltara el módulo la web daría error 500.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
<IfModule mod_filter.c>
  <IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml application/xml text/xml text/plain
  </IfModule>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml application/xml text/xml text/plain
  </IfModule>
</IfModule>

# Cabeceras de seguridad (las mismas que vercel.json). "always" hace que también se envíen en
# las redirecciones y en la página 404 (ErrorDocument), no solo en las respuestas 200.
<IfModule mod_headers.c>
  # Content-Security-Policy: solo se ejecuta y se carga lo que la web usa de verdad.
  #  - script-src 'self': el JS es el bundle de Vite (/assets). Sin 'unsafe-inline' ni
  #    'unsafe-eval'. El JSON-LD de index.html es <script type="application/ld+json">: un
  #    bloque de datos que el navegador no ejecuta, así que la CSP no le afecta.
  #  - style-src 'self': solo la hoja de /assets. Los estilos que ponen React y motion desde
  #    JS (element.style) no son estilos "inline" para la CSP y no necesitan 'unsafe-inline'.
  #  - img-src data:: el GIF vacío de 1×1 que usa Mantenimiento en móvil para no descargar
  #    una foto oculta.
  #  - connect-src https://formsubmit.co: envío de ContactForm y PlanForm (fetch).
  #  - frame-src https://www.google.com: el mapa de Google Maps, que solo se carga tras
  #    pulsar el botón (src/utils/contact.ts, mapsEmbed).
  #  - Si se añade un servicio externo nuevo (analítica, chat, otro iframe...), hay que
  #    añadir su origen aquí o el navegador lo bloqueará (se ve en la consola).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://formsubmit.co; frame-src https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  # Redundante con frame-ancestors 'none' de la CSP; se mantiene para navegadores antiguos.
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Aísla la ventana de la web de las que abra o la abran (los enlaces externos ya llevan
  # rel="noopener noreferrer").
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # X-XSS-Protection se ha quitado a propósito: el filtro XSS de los navegadores ya no existe
  # y la recomendación actual es no enviar la cabecera (la protección real es la CSP).

  # HSTS (Strict-Transport-Security): DESACTIVADO hasta verificar el HTTPS de Nominalia.
  # Obliga al navegador a usar solo HTTPS durante max-age segundos, sin posibilidad de
  # volver atrás desde el servidor: si el certificado falla o caduca, la web queda
  # inaccesible para quien ya la visitó. Activarlo solo cuando:
  #   1) https://www.dyfservicios.com y https://dyfservicios.com cargan con certificado
  #      válido y la renovación automática está comprobada;
  #   2) todas las redirecciones http -> https funcionan (ya probado en Apache real).
  # No añadir "includeSubDomains" ni "preload" salvo que TODOS los subdominios de
  # dyfservicios.com (correo, webmail, etc.) funcionen también por HTTPS.
  # Paso 1: quitar la "#" de esta línea (1 día) y comprobar que todo sigue funcionando.
  # Header always set Strict-Transport-Security "max-age=86400"
  # Paso 2: tras unos días sin problemas, sustituirla por esta (1 año).
  # Header always set Strict-Transport-Security "max-age=31536000"

  # Cache-Control agresivo solo para los archivos versionados que genera Vite en /assets.
  # <FilesMatch> compara SOLO el nombre del archivo (nunca la ruta "assets/"), así que se
  # identifican por el hash de 8 caracteres que Vite añade: p. ej. "index-B49HrtL_.js".
  # Solo js/css/woff2: las imágenes de /public no llevan hash y no deben cachearse como inmutables.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Imágenes e iconos de /public: no llevan hash en el nombre, así que no pueden ser
  # "immutable"; 7 días. Si se sustituye una imagen conviene cambiarle el nombre.
  <FilesMatch "\.(webp|avif|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Manifiesto de la web app: 1 día.
  <FilesMatch "\.webmanifest$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # Todos los HTML (index.html, servicios.html, 404.html...) se revalidan siempre: así, tras
  # publicar una versión nueva, el navegador no usa un HTML antiguo que apunta a archivos
  # de /assets que ya no existen.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
