# DYF Telecomunicaciones — configuración para hosting compartido Apache (Nominalia)
# Este archivo se copia tal cual a /dist en cada build de Vite (public/ -> dist/).

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 0. Redirecciones 301 de la web antigua (HTML estático, indexada por Google con y sin "www"
  #    y solo por http). Van ANTES de las reglas de HTTPS y www para que cada URL antigua
  #    llegue a su destino final en UN solo salto (http://dyfservicios.com/servicios.html ->
  #    https://www.dyfservicios.com/servicios), sin encadenar tres redirecciones.
  #    En .htaccess el patrón se compara con la ruta SIN la barra inicial ("servicios.html").
  #    [NC] = sin distinguir mayúsculas; la query string (?fbclid=...) se conserva sola.
  #
  #    index.html necesita la condición THE_REQUEST: la regla final de la SPA reescribe
  #    internamente cualquier ruta a "index.html" y mod_dir hace lo mismo con "/", y mod_rewrite
  #    vuelve a evaluar este archivo con esa ruta interna. Sin la condición, la propia portada
  #    se redirigiría a sí misma en bucle. THE_REQUEST es la línea original que envió el
  #    navegador ("GET /index.html HTTP/1.1") y no cambia con las reescrituras internas.
  RewriteCond %{THE_REQUEST} \s/index\.html?[\s?] [NC]
  RewriteRule ^index\.html?$ https://www.dyfservicios.com/ [R=301,L,NC]
  RewriteRule ^nosotros\.html?$ https://www.dyfservicios.com/equipo [R=301,L,NC]
  RewriteRule ^servicios\.html?$ https://www.dyfservicios.com/servicios [R=301,L,NC]
  RewriteRule ^comunidades\.html?$ https://www.dyfservicios.com/mantenimiento [R=301,L,NC]
  RewriteRule ^contacto\.html?$ https://www.dyfservicios.com/contacto [R=301,L,NC]

  # 1. Forzar HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Forzar dominio con "www" (coincide con el resto de la configuración: sitemap.xml, robots.txt, og:url)
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 3. Enrutado de React Router: si el archivo o directorio solicitado no existe físicamente,
  #    servir siempre index.html para que React Router gestione la ruta en el cliente.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Cabeceras de seguridad (equivalentes a vercel.json)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Cache-Control agresivo solo para los archivos versionados que genera Vite en /assets.
  # <FilesMatch> compara SOLO el nombre del archivo (nunca la ruta "assets/"), así que se
  # identifican por el hash de 8 caracteres que Vite añade: p. ej. "index-B49HrtL_.js".
  # Solo js/css/woff2: las imágenes de /public no llevan hash y no deben cachearse como inmutables.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html siempre se revalida: así, tras publicar una versión nueva, el navegador
  # no sigue usando un index.html antiguo que apunta a archivos que ya no existen.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# No indexar el listado de directorios
Options -Indexes
