# DYF Telecomunicaciones — configuración para hosting compartido Apache (Nominalia)
# Este archivo se copia tal cual a /dist en cada build de Vite (public/ -> dist/).
# Las rutas de las secciones 3 y 4 las comprueba scripts/generar-cabeceras.mjs en cada
# `npm run build`: si no coinciden con App.tsx, src/seo/rutas.json y sitemap.xml, el build falla.

# Sin listado de directorios. Sin MultiViews: si no, Apache podría servir servicios.html para
# /servicios por negociación de contenido, al margen de estas reglas.
Options -Indexes -MultiViews

# Cualquier URL que no sea una ruta conocida ni un archivo existente: 404 real con la página
# 404 generada (noindex, sin canonical). Ruta local: Apache conserva el código 404.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 0. Redirecciones 301 de la web antigua (HTML estático, indexada por Google con y sin "www"
  #    y solo por http). Van ANTES de las reglas de HTTPS y www para que cada URL antigua
  #    llegue a su destino final en UN solo salto (http://dyfservicios.com/servicios.html ->
  #    https://www.dyfservicios.com/servicios). En .htaccess el patrón se compara con la ruta
  #    SIN la barra inicial ("servicios.html"). [NC] = sin distinguir mayúsculas; la query
  #    string (?fbclid=...) se conserva sola.
  #
  #    TODAS llevan la condición THE_REQUEST: es la línea original que envió el navegador
  #    ("GET /servicios.html HTTP/1.1") y no cambia con las reescrituras internas. Hace falta
  #    porque la sección 4 reescribe /servicios -> servicios.html (y mod_dir, / -> index.html),
  #    y Apache vuelve a evaluar este archivo con esa ruta interna: sin la condición, la regla
  #    de servicios.html la atraparía y redirigiría /servicios a sí misma en bucle.
  RewriteCond %{THE_REQUEST} \s/index\.html?[\s?] [NC]
  RewriteRule ^index\.html?$ https://www.dyfservicios.com/ [R=301,L,NC]
  RewriteCond %{THE_REQUEST} \s/nosotros\.html?[\s?] [NC]
  RewriteRule ^nosotros\.html?$ https://www.dyfservicios.com/equipo [R=301,L,NC]
  RewriteCond %{THE_REQUEST} \s/servicios\.html?[\s?] [NC]
  RewriteRule ^servicios\.html?$ https://www.dyfservicios.com/servicios [R=301,L,NC]
  RewriteCond %{THE_REQUEST} \s/comunidades\.html?[\s?] [NC]
  RewriteRule ^comunidades\.html?$ https://www.dyfservicios.com/mantenimiento [R=301,L,NC]
  RewriteCond %{THE_REQUEST} \s/contacto\.html?[\s?] [NC]
  RewriteRule ^contacto\.html?$ https://www.dyfservicios.com/contacto [R=301,L,NC]

  # 1. Forzar HTTPS, directamente al dominio con www (un solo salto desde http://sin-www)
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://www.dyfservicios.com%{REQUEST_URI} [L,R=301]

  # 2. Forzar "www" cuando ya se llega por https sin www
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 3. Rutas conocidas con barra final -> 301 a la URL canónica (sin barra y en minúsculas).
  RewriteRule ^equipo/$ https://www.dyfservicios.com/equipo [R=301,L,NC]
  RewriteRule ^servicios/$ https://www.dyfservicios.com/servicios [R=301,L,NC]
  RewriteRule ^contacto/$ https://www.dyfservicios.com/contacto [R=301,L,NC]
  RewriteRule ^mantenimiento/$ https://www.dyfservicios.com/mantenimiento [R=301,L,NC]
  RewriteRule ^gracias/$ https://www.dyfservicios.com/gracias [R=301,L,NC]
  RewriteRule ^aviso-legal/$ https://www.dyfservicios.com/aviso-legal [R=301,L,NC]
  RewriteRule ^politica-privacidad/$ https://www.dyfservicios.com/politica-privacidad [R=301,L,NC]

  # 4. Rutas conocidas -> su HTML con la cabecera propia (generado en el build). El destino es
  #    siempre en minúsculas, así /SERVICIOS también sirve servicios.html (el canonical ya es
  #    /servicios). La portada "/" la sirve mod_dir con index.html. Todo lo demás que no sea un
  #    archivo existente cae en el ErrorDocument 404 de arriba: ya no hay fallback genérico.
  RewriteRule ^equipo$ equipo.html [L,NC]
  RewriteRule ^servicios$ servicios.html [L,NC]
  RewriteRule ^contacto$ contacto.html [L,NC]
  RewriteRule ^mantenimiento$ mantenimiento.html [L,NC]
  RewriteRule ^gracias$ gracias.html [L,NC]
  RewriteRule ^aviso-legal$ aviso-legal.html [L,NC]
  RewriteRule ^politica-privacidad$ politica-privacidad.html [L,NC]
</IfModule>

# Cabeceras de seguridad (equivalentes a vercel.json)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Cache-Control agresivo solo para los archivos versionados que genera Vite en /assets.
  # <FilesMatch> compara SOLO el nombre del archivo (nunca la ruta "assets/"), así que se
  # identifican por el hash de 8 caracteres que Vite añade: p. ej. "index-B49HrtL_.js".
  # Solo js/css/woff2: las imágenes de /public no llevan hash y no deben cachearse como inmutables.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Todos los HTML (index.html, servicios.html, 404.html...) se revalidan siempre: así, tras
  # publicar una versión nueva, el navegador no usa un HTML antiguo que apunta a archivos
  # de /assets que ya no existen.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
